[
  {
    "name": "topbar",
    "layer": "overlay",
    "position": "top",
    "margin-top": 5,
    "margin-right": 20,
    "margin-left": 20,
    "height": 30,
    "modules-left": ["sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": [
      "cpu",
      "memory",
      "pulseaudio",
      "network",
      "group/batlight",
      "tray",
      "custom/notification",
    ],
    "group/batlight": {
      "orientation": "horizontal",
      "modules": ["power-profiles-daemon", "battery", "backlight"],
    },
    "clock": {
      "format": "  {:%H:%M  %a %d %b}",
      "tooltip-format": "{:%A, %d %B %Y • %H:%M:%S %Z}",
    },
    "cpu": {
      "format": "  {usage}%",
      "tooltip": true,
    },
    "memory": {
      "format": "  {percentage}%",
      "tooltip": true,
    },
    "pulseaudio": {
      "format": "  {volume}%",
      "format-muted": "  muted",
      "scroll-step": 5,
      "tooltip": true,
    },
    "network": {
      "format-wifi": "{icon} {signalStrength}%",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰤮",
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "tooltip-format-wifi": "{essid}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}\nIP: {ipaddr}",
      "tooltip-format-ethernet": "{ifname}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}\nIP: {ipaddr}",
      "tooltip-format-disconnected": "Disconnected",
      "interval": 5,
    },
    "sway/window": {
      "hide-if-empty": true,
      "format": "{title}",
    },
    "battery": {
      "bat": "BAT0",
      "adapter": "AC",
      "full-at": 80,
      "format": "{icon} {capacity}%",
      "format-charging": " {capacity}%",
      "format-plugged": " {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "states": {
        "warning": 30,
        "critical": 15,
      },
      "tooltip": true,
      "hide-if-empty": true,
    },
    "backlight": {
      "format": " {percent}%",
      "tooltip": true,
      "hide-if-empty": true,
    },
    "tray": {
      "icon-size": 16,
      "spacing": 8,
    },
    "custom/notification": {
      "tooltip": true,
      "format": "{0} {icon}",
      "format-icons": {
        "notification": "󱅫",
        "none": "󰂜",
        "dnd-notification": "󰂠",
        "dnd-none": "󰪓",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰪑",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰪑",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}",
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": "",
      },
    },
  },
]
