[Unit]
Description=tmux default session (detached)
Documentation=man:tmux(1)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -lc '/usr/bin/tmux has-session -t main 2>/dev/null || /usr/bin/tmux new-session -d -s main'
ExecStop=/usr/bin/tmux kill-server

[Install]
WantedBy=default.target
