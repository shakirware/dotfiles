{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",

  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-margin-top": 45,
  "control-center-margin-right": 20,

  "notification-window-width": 460,
  "notification-window-height": 220,

  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "fit-to-screen": true,

  "cssPriority": "user",
  "ignore-gtk-theme": true,

  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "show-album-art": "when-available",
      "blacklist": [],
      "autohide": true,
      "loop-carousel": false
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-label": false
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight",
      "subsystem": "backlight"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
